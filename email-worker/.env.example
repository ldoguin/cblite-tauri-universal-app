# ── Provider selection ────────────────────────────────────────────────────────
# "agentmail" or "gmail"
EMAIL_PROVIDER=agentmail

# ── User configuration ────────────────────────────────────────────────────────
# JSON array of user objects. Shape depends on provider:
#
# AgentMail:
#   [{"username":"alice","email":"alice@yourdomain.agentmail.to"}]
#
# Gmail:
#   [{"username":"alice","gmail_refresh_token":"1//0g..."}]
#
USERS=[{"username":"alice","email":"alice@yourdomain.agentmail.to"}]

# ── AgentMail ─────────────────────────────────────────────────────────────────
AGENTMAIL_API_KEY=your-agentmail-api-key
AGENTMAIL_DOMAIN=yourdomain.agentmail.to

# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: override base URL for Ollama, Azure, etc.
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Sync Gateway ──────────────────────────────────────────────────────────────
SYNC_GATEWAY_URL=http://localhost:4984
SYNC_GATEWAY_DB=notes
# Optional dedicated service account; falls back to per-user credentials
# SG_SERVICE_USERNAME=sgservice
# SG_SERVICE_PASSWORD=sgpassword
# Per-user SG passwords: SG_PASSWORD_<USERNAME>=password
# e.g. SG_PASSWORD_ALICE=alicepassword

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60

# ── Webhook (optional) ────────────────────────────────────────────────────────
# Set to enable webhook push mode in addition to polling
# WEBHOOK_PORT=3001

# ── Dedup state DB ────────────────────────────────────────────────────────────
STATE_DB_PATH=./data

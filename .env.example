# ══════════════════════════════════════════════════════════════════════════════
# Docker Compose environment — copy to .env and fill in secrets
# ══════════════════════════════════════════════════════════════════════════════

# ── Couchbase ─────────────────────────────────────────────────────────────────
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=password
COUCHBASE_BUCKET=auth

# Private bucket — one CB scope per user, holds notes/conversations/tasks/actions/chunks
PRIVATE_BUCKET=private
# Public bucket — shared reference data (articles, templates, shared_knowledge, chunks)
PUBLIC_BUCKET=public

# Couchbase Search REST endpoint — used for vector index management and server RAG queries
CB_SEARCH_URL=http://localhost:8094
# "user:pass" used by workers for Couchbase vector search REST auth
CB_CREDENTIALS=Administrator:password

# ── Sync Gateway ──────────────────────────────────────────────────────────────
# Private SG database (per-user channel routing, push+pull)
SG_PRIVATE_DB=private-db
SYNC_GATEWAY_SYNC_URL=ws://localhost:4984/private-db
# Public SG database (role-based read, pull-only for clients)
SG_PUBLIC_DB=public-db
SG_PUBLIC_SYNC_URL=ws://localhost:4984/public-db
# Basic auth header for SG admin API: base64("user:pass")
SYNC_GATEWAY_ADMIN_AUTH=

# ── External sync functions (optional) ────────────────────────────────────────
# Path to a JSON file containing per-collection sync functions for each SG database.
# If set, the file MUST exist and be valid JSON — the server will exit on error.
# If unset, built-in default sync functions are used.
#
# File format (one file per SG database):
# {
#   "_default": {
#     "notes":         "function(doc, oldDoc) { ... }",
#     "conversations": "function(doc, oldDoc) { ... }",
#     "tasks":         "function(doc, oldDoc) { ... }",
#     "actions":       "function(doc, oldDoc) { ... }",
#     "chunks":        "function(doc, oldDoc) { ... }"
#   }
# }
#
# Collections not present in the file fall back to the built-in default.
# SG_PRIVATE_SYNC_FN=/config/sync-fns/private-db.json
# SG_PUBLIC_SYNC_FN=/config/sync-fns/public-db.json

# ── Auth server ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Users (shared by all workers) ─────────────────────────────────────────────
# JSON array — add provider-specific fields per worker below
USERS=[{"username":"alice"}]

# Per-user SG passwords (used by workers to authenticate with SG on behalf of each user)
SG_PASSWORD_ALICE=alicepassword

# Optional: SG service account — if set, workers use this single account instead of
# per-user passwords. Useful when SG is configured with a service-account role.
# SG_SERVICE_USERNAME=worker-service
# SG_SERVICE_PASSWORD=

# ── Worker identity ───────────────────────────────────────────────────────────
# Set automatically by docker-compose via the WORKER_NAME env var in each service
# block. Only needed when running a worker directly outside Docker.
# WORKER_NAME=github-worker

# ── KB facts extraction ────────────────────────────────────────────────────────
# Set to "false" to disable KB fact extraction for all workers (default: "true").
# Can be overridden per-container in docker-compose.yml.
KB_FACTS_ENABLED=true

# ── LLM mode (per worker — override in each worker's section if needed) ───────
LLM_MODE=llm

# ── Embedding & chunking (shared by all workers) ──────────────────────────────
# OpenAI-compatible embedding model. Uses the same OPENAI_BASE_URL as LLM calls,
# so pointing to Ollama or Azure covers both chat completions and embeddings.
EMBEDDING_MODEL=text-embedding-3-large
# Chunk size in tokens (approximate)
CHUNK_SIZE=512
# Overlap between consecutive chunks in tokens
CHUNK_OVERLAP=64
# Number of top chunks returned by RAG retrieval
RAG_TOP_K=5

# Local embedding model for the Tauri app (WASM/ONNX via @xenova/transformers).
# If unset, the app downloads all-MiniLM-L6-v2 from HuggingFace on first use.
# VITE_LOCAL_EMBEDDING_MODEL_PATH=/path/to/local/onnx/model

# ── Knowledge base (per user) ─────────────────────────────────────────────────
# Workers load each user's knowledge base from SG (collection: _default.user_data,
# doc id: "user_kb"). If the SG document doesn't exist yet, a local JSON file is
# used as a fallback.
#
# Per-user fallback file (env key pattern: KB_FILE_<USERNAME>):
# KB_FILE_ALICE=/data/kb/alice.json
#
# Global fallback used when no per-user file is set:
# KB_FILE=/data/kb/default.json
#
# Example JSON structure for a KB file:
# {
#   "type": "user_kb",
#   "owner": "alice",
#   "displayName": "Alice Smith",
#   "role": "Senior Engineer",
#   "timezone": "America/New_York",
#   "language": "en",
#   "projects": [
#     { "name": "Acme API", "keywords": ["acme-api", "ACME"], "description": "REST API rewrite" }
#   ],
#   "contacts": [
#     { "name": "bob@company.com", "relationship": "manager" }
#   ],
#   "ignorePatterns": ["Dependabot", "CI passed", "Renovate"],
#   "priorityPatterns": ["production", "urgent", "customer bug"],
#   "customInstructions": "Always suggest a Loom response for customer-facing bug reports."
# }

# ── email-worker ──────────────────────────────────────────────────────────────
EMAIL_PROVIDER=agentmail
AGENTMAIL_API_KEY=
AGENTMAIL_DOMAIN=yourdomain.agentmail.to
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
POLL_INTERVAL_SECONDS=60

# ── imap-worker ───────────────────────────────────────────────────────────────
IMAP_HOST_ALICE=imap.example.com
IMAP_PORT_ALICE=993
IMAP_USER_ALICE=alice@example.com
IMAP_PASS_ALICE=
IMAP_TLS_ALICE=true
IMAP_MAILBOX_ALICE=INBOX

# ── outlook-worker ────────────────────────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
OUTLOOK_REFRESH_TOKEN_ALICE=

# ── github-worker ─────────────────────────────────────────────────────────────
GITHUB_TOKEN_ALICE=ghp_...
# GITHUB_WEBHOOK_SECRET=

# ── gitlab-worker ─────────────────────────────────────────────────────────────
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN_ALICE=glpat-...

# ── jira-worker ───────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL_ALICE=alice@company.com
JIRA_API_TOKEN_ALICE=ATATT...

# ── slack-worker ──────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_PORT=3003

# ── telegram-worker ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=https://yourserver.com  # omit for long-poll mode
TELEGRAM_WEBHOOK_PORT=3005

# ── whatsapp-worker ───────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_PORT=3006

# ── signal-worker ─────────────────────────────────────────────────────────────
SIGNAL_ACCOUNT=+1XXXXXXXXXX
# Directory on the HOST containing the signal-cli Unix socket
SIGNAL_CLI_SOCKET_DIR=/var/run/signal-cli

# ── calendly-worker ───────────────────────────────────────────────────────────
SCHEDULING_PROVIDER=calendly
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SECRET=
CALENDLY_URI_ALICE=https://api.calendly.com/users/XXXX
# CALCOM_API_KEY=
# CALCOM_WEBHOOK_SECRET=
# CALCOM_USER_ID_ALICE=123
CALENDLY_WEBHOOK_PORT=3004

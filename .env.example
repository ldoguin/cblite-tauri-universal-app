# ══════════════════════════════════════════════════════════════════════════════
# Docker Compose environment — copy to .env and fill in secrets
# ══════════════════════════════════════════════════════════════════════════════

# ── Couchbase ─────────────────────────────────────────────────────────────────
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=password
COUCHBASE_BUCKET=auth

# ── Sync Gateway ──────────────────────────────────────────────────────────────
SYNC_GATEWAY_DB=notes
# Basic auth header for SG admin API: base64("user:pass")
SYNC_GATEWAY_ADMIN_AUTH=

# ── Auth server ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Users (shared by all workers) ─────────────────────────────────────────────
# JSON array — add provider-specific fields per worker below
USERS=[{"username":"alice"}]

# Per-user SG passwords
SG_PASSWORD_ALICE=alicepassword

# ── LLM mode (per worker — override in each worker's section if needed) ───────
LLM_MODE=llm

# ── email-worker ──────────────────────────────────────────────────────────────
EMAIL_PROVIDER=agentmail
AGENTMAIL_API_KEY=
AGENTMAIL_DOMAIN=yourdomain.agentmail.to
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
POLL_INTERVAL_SECONDS=60

# ── imap-worker ───────────────────────────────────────────────────────────────
IMAP_HOST_ALICE=imap.example.com
IMAP_PORT_ALICE=993
IMAP_USER_ALICE=alice@example.com
IMAP_PASS_ALICE=
IMAP_TLS_ALICE=true
IMAP_MAILBOX_ALICE=INBOX

# ── outlook-worker ────────────────────────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
OUTLOOK_REFRESH_TOKEN_ALICE=

# ── github-worker ─────────────────────────────────────────────────────────────
GITHUB_TOKEN_ALICE=ghp_...
# GITHUB_WEBHOOK_SECRET=

# ── gitlab-worker ─────────────────────────────────────────────────────────────
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN_ALICE=glpat-...

# ── jira-worker ───────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL_ALICE=alice@company.com
JIRA_API_TOKEN_ALICE=ATATT...

# ── slack-worker ──────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_PORT=3003

# ── telegram-worker ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=https://yourserver.com  # omit for long-poll mode
TELEGRAM_WEBHOOK_PORT=3005

# ── whatsapp-worker ───────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_PORT=3006

# ── signal-worker ─────────────────────────────────────────────────────────────
SIGNAL_ACCOUNT=+1XXXXXXXXXX
# Directory on the HOST containing the signal-cli Unix socket
SIGNAL_CLI_SOCKET_DIR=/var/run/signal-cli

# ── calendly-worker ───────────────────────────────────────────────────────────
SCHEDULING_PROVIDER=calendly
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SECRET=
CALENDLY_URI_ALICE=https://api.calendly.com/users/XXXX
# CALCOM_API_KEY=
# CALCOM_WEBHOOK_SECRET=
# CALCOM_USER_ID_ALICE=123
CALENDLY_WEBHOOK_PORT=3004

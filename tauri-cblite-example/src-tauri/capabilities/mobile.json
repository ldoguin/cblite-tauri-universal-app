{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capability for Android and iOS",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "opener:default",
    "cblite:default",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive"
  ]
}

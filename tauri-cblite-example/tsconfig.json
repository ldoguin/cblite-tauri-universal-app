{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@cblite-uni-app/cblite-adapter": ["../packages/cblite-adapter/src/index.ts"],
      "@cblite-uni-app/shared": ["../packages/shared/src/index.ts"],
      "@cblite-uni-app/shared/components": ["../packages/shared/src/components/index.ts"]
    }
  },
  "include": [
    "src",
    "../packages/cblite-adapter/src/tauri.d.ts"
  ]
}

# "calendly" or "calcom"
SCHEDULING_PROVIDER=calendly

# ── Calendly ──────────────────────────────────────────────────────────────────
CALENDLY_TOKEN=your_personal_access_token
CALENDLY_WEBHOOK_SECRET=your_webhook_signing_secret
# Calendly user URIs per user: CALENDLY_URI_<USERNAME>
CALENDLY_URI_ALICE=https://api.calendly.com/users/XXXXXXXXXXXX

# ── Cal.com ───────────────────────────────────────────────────────────────────
# CALCOM_API_KEY=cal_live_...
# CALCOM_WEBHOOK_SECRET=your_calcom_secret
# Cal.com user IDs per user: CALCOM_USER_ID_<USERNAME>
# CALCOM_USER_ID_ALICE=123

# ── Users ─────────────────────────────────────────────────────────────────────
USERS=[{"username":"alice"}]

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_MODE=passthrough

# ── Sync Gateway ──────────────────────────────────────────────────────────────
SYNC_GATEWAY_URL=http://localhost:4984
SYNC_GATEWAY_DB=notes
SG_PASSWORD_ALICE=alicepassword

# ── Webhook (required) ────────────────────────────────────────────────────────
WEBHOOK_PORT=3004

# ── State DB ──────────────────────────────────────────────────────────────────
STATE_DB_PATH=./data

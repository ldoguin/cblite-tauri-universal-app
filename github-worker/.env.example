# ── Provider ──────────────────────────────────────────────────────────────────
# Per-user GitHub PATs: GITHUB_TOKEN_<USERNAME>
# e.g. GITHUB_TOKEN_ALICE=ghp_...
GITHUB_TOKEN_ALICE=ghp_your_token_here

# Optional: webhook secret for HMAC validation
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ── Users ─────────────────────────────────────────────────────────────────────
USERS=[{"username":"alice"}]

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_MODE=llm

# ── Sync Gateway ──────────────────────────────────────────────────────────────
SYNC_GATEWAY_URL=http://localhost:4984
SYNC_GATEWAY_DB=notes
SG_PASSWORD_ALICE=alicepassword

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60

# ── Webhook (optional) ────────────────────────────────────────────────────────
# WEBHOOK_PORT=3002

# ── State DB ──────────────────────────────────────────────────────────────────
STATE_DB_PATH=./data

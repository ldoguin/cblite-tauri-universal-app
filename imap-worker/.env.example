# ── IMAP connection ───────────────────────────────────────────────────────────
# Per-user IMAP credentials. Each user needs:
#   IMAP_HOST_<USERNAME>      IMAP server hostname
#   IMAP_PORT_<USERNAME>      Port (default: 993 for TLS, 143 for STARTTLS)
#   IMAP_USER_<USERNAME>      Login username (usually the email address)
#   IMAP_PASS_<USERNAME>      Password or app-specific password
#   IMAP_TLS_<USERNAME>       "true" (default) for implicit TLS, "false" for STARTTLS
#   IMAP_MAILBOX_<USERNAME>   Mailbox to watch (default: INBOX)
#
# Example for alice:
IMAP_HOST_ALICE=imap.example.com
IMAP_PORT_ALICE=993
IMAP_USER_ALICE=alice@example.com
IMAP_PASS_ALICE=app-specific-password
IMAP_TLS_ALICE=true
IMAP_MAILBOX_ALICE=INBOX

# ── Users ─────────────────────────────────────────────────────────────────────
USERS=[{"username":"alice"}]

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_MODE=llm

# ── Sync Gateway ──────────────────────────────────────────────────────────────
SYNC_GATEWAY_URL=http://localhost:4984
SYNC_GATEWAY_DB=notes
SG_PASSWORD_ALICE=alicepassword

# ── Polling ───────────────────────────────────────────────────────────────────
# Used as fallback interval when IMAP IDLE is not supported by the server.
POLL_INTERVAL_SECONDS=60

# ── State DB ──────────────────────────────────────────────────────────────────
STATE_DB_PATH=./data

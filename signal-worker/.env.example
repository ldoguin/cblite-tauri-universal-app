# ── Prerequisites ─────────────────────────────────────────────────────────────
# signal-cli must be running as a daemon before starting this worker:
#
#   1. Install signal-cli: https://github.com/AsamK/signal-cli/releases
#   2. Register a dedicated phone number:
#        signal-cli -a +1XXXXXXXXXX register
#        signal-cli -a +1XXXXXXXXXX verify <code>
#   3. Start the daemon (exposes a Unix socket):
#        signal-cli -a +1XXXXXXXXXX daemon --socket /var/run/signal-cli/socket
#
# The worker connects to that socket via JSON-RPC.

SIGNAL_CLI_SOCKET=/var/run/signal-cli/socket
SIGNAL_ACCOUNT=+1XXXXXXXXXX

# Map Signal phone numbers (E.164) to app usernames
USERS=[{"username":"alice","signal_number":"+14155552671"}]

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_MODE=llm

SYNC_GATEWAY_URL=http://localhost:4984
SYNC_GATEWAY_DB=notes
SG_PASSWORD_ALICE=alicepassword

STATE_DB_PATH=./data
